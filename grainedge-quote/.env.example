# === App ===
APP_BASE_URL=http://localhost:8888
ADMIN_AUTH_SECRET=change-me-in-production

# === Email (optional for local dev — logs to console if missing) ===
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=quotes@grainedge.in
SALES_NOTIFY_EMAIL=sales@grainedge.in

# === Storage (default: blobs — zero config on Netlify) ===
STORAGE_PROVIDER=blobs
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# === PDF ===
PDF_RENDER_TIMEOUT_MS=30000
